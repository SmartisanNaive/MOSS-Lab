# 将此文件复制到本项目目录，命名为 .env；不要上传真实凭据。
# AI 模型服务（必填）：与 OpenAI Chat Completions 兼容的 HTTPS 地址。
AI_API_KEY=
AI_API_URL=https://example.com/v1/chat/completions
AI_MODEL=

# 小智 MCP 接入地址（可选；不填时仍可使用本地网页；包含凭据，须保密）。
XIAOZHI_WSS_URL=

# 首次委派、追问条件和当前预览就绪时打开/置前工作台（macOS 默认启用；设 0 关闭）。
MOSS_AUTO_WAKE=1
# macOS 支持 Google Chrome、Microsoft Edge、Safari；复用同一来源的工作台标签页。
MOSS_BROWSER_APP=Google Chrome

# 机器人服务根地址（设备状态查询可选）。需支持 GET /health 与 /instruments。
# 下方仅为地址格式示例，请换成实际可访问的机器人服务地址。
OPENTRONS_URL=http://192.168.1.100:31950

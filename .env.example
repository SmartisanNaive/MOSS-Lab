# 将此文件复制到本项目目录，命名为 .env；不要上传真实凭据。
# AI 模型服务（必填）：与 OpenAI Chat Completions 兼容的 HTTPS 地址。
AI_API_KEY=
AI_API_URL=https://example.com/v1/chat/completions
AI_MODEL=

# 小智 MCP 接入地址（可选；不填时仍可使用本地网页；包含凭据，须保密）。
XIAOZHI_WSS_URL=

# 首次委派、追问条件和当前预览就绪时打开/置前工作台（macOS 默认启用；设 0 关闭）。
MOSS_AUTO_WAKE=1
# macOS 支持 Google Chrome、Microsoft Edge、Safari；复用同一来源的工作台标签页。
MOSS_BROWSER_APP=Google Chrome

# 机器人服务根地址（可选）：用于设备状态查询，以及经操作员确认的协议运行；必须是 http 或 https 地址。
# 下方仅为地址格式示例，请换成实际可访问的机器人服务地址。
OPENTRONS_URL=https://robot.example.com

# 真机运行开关（可选）：默认开启；设为 0 可禁止所有真机动作，只保留本地仿真和状态查询。
MOSS_ALLOW_LIVE_ROBOT=1

# 台面视觉（可选）：识别脚本、训练模型和台面标定文件的绝对路径；留空用仓库内置路径。
# 识别前需在项目 Python 环境安装 ultralytics 和 opencv-python-headless（见 MOSS-LAB.md）。
MOSS_VISION_SCRIPT=
MOSS_VISION_WEIGHTS=
MOSS_VISION_CALIBRATION=
